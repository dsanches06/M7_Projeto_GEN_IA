# Variáveis de Ambiente - Exemplo

# ===== DATABASE =====
# PostgreSQL via Neon (recomendado para Vercel)
DATABASE_URL=postgresql://neondb_owner:password@ep-xxxx-pooler.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require

# ===== API CONFIGURATION =====
# URL da aplicação frontend (para CORS)
CLIENT_URL=https://seu-app.vercel.app

# ===== GOOGLE AI API =====
# Modelo a usar
MODEL_NAME=model_name

# Chave da API Google Generative AI
GEMINI_API_KEY=your_google_api_key_here

# ===== DEVELOPMENT =====
# Modo de desenvolvimento (opcional)
NODE_ENV=production

# ===== LOGGING =====
# Nível de log (opcional)
LOG_LEVEL=info
