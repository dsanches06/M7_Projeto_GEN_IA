{
  "version": 2,
  "buildCommand": "npm install && npm --prefix clickUp install && npm --prefix clickUp run build && npm run init-db",
  "outputDirectory": "clickUp/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "backend/neon_database/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
